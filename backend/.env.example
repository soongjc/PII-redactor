OLLAMA_HOST=http://localhost:11434
VL_MODEL=qwen2.5vl:7b
PII_MODEL=qwen3:8b

# VL backend: "ollama" or "llamacpp" (upstream llama-server for models Ollama
# hasn't wired vision for, e.g. dots.ocr). llama-server must be running on
# LLAMACPP_HOST with --mmproj and the vision GGUF.
VL_BACKEND=ollama
LLAMACPP_HOST=http://localhost:11500

# VL prompt preset: "qwen" (works with Qwen2.5-VL) or "dotsocr" (dots.ocr's
# native prompt_layout_all_en). Set to "dotsocr" when VL_BACKEND=llamacpp and
# you're running dots.ocr.
VL_PROMPT_MODE=qwen

# Force Ollama's structured-JSON output mode. Works great with Qwen2.5-VL and
# Qwen3, but can cause the model to produce NO tokens at all on some brand-new
# vision models (e.g. qwen3-vl on Ollama 0.21 — you'll see "stream>" then
# silence). Set to false and we still strip/parse JSON on our side.
VL_FORMAT_JSON=true
PII_FORMAT_JSON=true

# Disable Qwen3-family "thinking" mode. Qwen3 / qwen3-vl route reasoning into
# a separate `thinking` field; if the model stays in reasoning too long it may
# emit ZERO content chars (symptoms: long elapsed, "0 chars" warning). Setting
# `think: false` makes the model answer directly. Ignored by non-Qwen3 models.
VL_DISABLE_THINK=true
PII_DISABLE_THINK=true
DATABASE_URL=sqlite:///./storage/pii.db
STORAGE_DIR=./storage
PDF_DPI=150

# Max total pixels after our smart_resize (matches Qwen2.5-VL's internal
# preprocessor). Upstream default is 1003520; 802816 is faster with slightly
# less OCR headroom on dense pages.
VL_MAX_PIXELS=802816

# Ollama token limits. num_ctx=0 means "don't send the option" (avoids the
# Metal GGML_ASSERT crash with images). num_predict caps generated tokens —
# raise if the VL output is truncated mid-JSON.
VL_NUM_CTX=0
VL_NUM_PREDICT=8192
PII_NUM_CTX=0
PII_NUM_PREDICT=4096

# HTTP timeouts to Ollama (seconds). Raise OLLAMA_TIMEOUT_S if you hit
# "Ollama request timed out" — first call after a restart can be slow
# because the model is cold-loaded.
OLLAMA_TIMEOUT_S=1200
OLLAMA_CONNECT_TIMEOUT_S=30

# Bbox calibration. Vertical expansion is 0 by default so the refiner
# doesn't grab the neighbouring line's text on dense documents. Raise
# REFINE_EXPAND_Y_PCT to ~0.05 if boxes clip ascenders/descenders.
REFINE_BBOXES=true
REFINE_EXPAND_X_PCT=0.10
REFINE_EXPAND_Y_PCT=0.0
REFINE_THRESHOLD=180
MASK_PADDING_PX=2

# Drop VL regions that look like money (e.g. "233.50", "RM 1,200", "$100.00").
# Money is not PII, and excluding it makes Qwen3's job cleaner.
VL_FILTER_MONEY=true

# Drop VL regions that look like dates (e.g. "2026-04-22", "Apr 22, 2026").
# WARNING: this also removes DOB detection. Set to false for IDs / medical
# records / HR documents where a date-of-birth might appear.
VL_FILTER_DATES=true
