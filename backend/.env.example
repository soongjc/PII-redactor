OLLAMA_HOST=http://localhost:11434
VL_MODEL=qwen2.5vl:7b
PII_MODEL=qwen3:8b
DATABASE_URL=sqlite:///./storage/pii.db
STORAGE_DIR=./storage
PDF_DPI=150

# Max total pixels after our smart_resize (matches Qwen2.5-VL's internal
# preprocessor). Upstream default is 1003520; 802816 is faster with slightly
# less OCR headroom on dense pages.
VL_MAX_PIXELS=802816

# Ollama token limits. Set to 0 to skip sending the option and use Ollama's
# own Modelfile defaults — this is the safest choice on Ollama builds that
# GGML_ASSERT-crash when a custom num_ctx is sent with images.
# Non-zero values override Ollama's defaults. On macOS Metal, keep <= 8192.
VL_NUM_CTX=0
VL_NUM_PREDICT=0
PII_NUM_CTX=0
PII_NUM_PREDICT=0

# Bbox calibration.
REFINE_BBOXES=true
REFINE_EXPAND_PCT=0.10
REFINE_THRESHOLD=180
MASK_PADDING_PX=2
