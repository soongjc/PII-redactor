OLLAMA_HOST=http://localhost:11434
VL_MODEL=qwen2.5vl:7b
PII_MODEL=qwen3:8b
DATABASE_URL=sqlite:///./storage/pii.db
STORAGE_DIR=./storage
PDF_DPI=150

# Pre-resize the page to this max edge (px) before sending to VL.
# Qwen-VL returns bboxes in its internal resized space, so we resize ourselves
# to a known size and scale back. Smaller = faster + less VRAM; larger = more OCR accuracy.
VL_INPUT_MAX_SIDE=1280

# Ollama limits — raise if VL truncates on dense pages.
VL_NUM_CTX=16384
VL_NUM_PREDICT=16384
PII_NUM_CTX=8192
PII_NUM_PREDICT=4096

# Bbox calibration.
REFINE_BBOXES=true
REFINE_EXPAND_PCT=0.10
REFINE_THRESHOLD=180
MASK_PADDING_PX=2
