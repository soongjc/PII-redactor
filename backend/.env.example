OLLAMA_HOST=http://localhost:11434
VL_MODEL=qwen2.5vl:7b
PII_MODEL=qwen3:8b
DATABASE_URL=sqlite:///./storage/pii.db
STORAGE_DIR=./storage
PDF_DPI=150

# Max total pixels after our smart_resize (matches Qwen2.5-VL's internal
# preprocessor). Upstream default is 1003520; 802816 is faster with slightly
# less OCR headroom on dense pages.
VL_MAX_PIXELS=802816

# Ollama limits. 8192 is safe on macOS Metal; higher can trigger GGML_ASSERT
# crashes with Qwen-VL on some llama.cpp builds. Raise gradually if needed.
VL_NUM_CTX=8192
VL_NUM_PREDICT=4096
PII_NUM_CTX=8192
PII_NUM_PREDICT=2048

# Bbox calibration.
REFINE_BBOXES=true
REFINE_EXPAND_PCT=0.10
REFINE_THRESHOLD=180
MASK_PADDING_PX=2
